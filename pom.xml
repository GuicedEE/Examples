<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.guicedee.examples</groupId>
    <artifactId>examples-parent</artifactId>
    <packaging>pom</packaging>
    <version>2.4.0</version>

    <name>GuicedEE Examples</name>
    <description>Examples to quickly kickstart your GuicedEE applications</description>
    <url>https://github.com/GuicedEE/Examples</url>

    <properties>
        <guicedee.version>2.4.0</guicedee.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <examples.runtimeImageDirectory>${project.build.directory}/jlink-image</examples.runtimeImageDirectory>
        <examples.runtimeDependencyDirectory>${project.build.directory}/libs/${guicedee.version}</examples.runtimeDependencyDirectory>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.guicedee</groupId>
                <artifactId>guicedee-bom</artifactId>
                <version>${guicedee.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Current integration coordinates not yet managed by the platform BOM. -->
            <dependency>
                <groupId>com.guicedee</groupId>
                <artifactId>cdi</artifactId>
                <version>${guicedee.version}</version>
            </dependency>
            <dependency>
                <groupId>com.guicedee</groupId>
                <artifactId>kafka</artifactId>
                <version>${guicedee.version}</version>
            </dependency>
            <dependency>
                <groupId>com.guicedee</groupId>
                <artifactId>ibmmq</artifactId>
                <version>${guicedee.version}</version>
            </dependency>
            <dependency>
                <groupId>com.guicedee</groupId>
                <artifactId>mail-client</artifactId>
                <version>${guicedee.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.15.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.5</version>
                </plugin>
                <plugin>
                    <groupId>org.moditect</groupId>
                    <artifactId>moditect-maven-plugin</artifactId>
                    <version>1.3.0.Final</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.11.0</version>
                <executions>
                    <execution>
                        <id>runtime-dependencies</id>
                        <phase>prepare-package</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <includeTypes>jar</includeTypes>
                            <outputDirectory>${examples.runtimeDependencyDirectory}</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <modules>
        <module>Inject</module>
        <module>CDI</module>
        <module>Config</module>
        <module>Health</module>
        <module>Metrics</module>
        <module>Telemetry</module>
        <module>Vertx</module>
        <module>Web</module>
        <module>Rest</module>
        <module>RestClient</module>
        <module>OpenAPI</module>
        <module>GraphQL</module>
        <module>WebServices</module>
        <module>WebSockets</module>
        <module>Persistence</module>
        <module>RabbitMQ</module>
        <module>Kafka</module>
        <module>IBMMQ</module>
        <module>Cerial</module>
        <module>FaultTolerance</module>
        <module>Hazelcast</module>
        <module>JWT</module>
        <module>Auth</module>
        <module>MailClient</module>
    </modules>


</project>
